digraph G {
  rankdir = "RL";
  node [shape = rect, fontname = "sans-serif"];
  subgraph "cluster_module.ingest_pipeline" {
    label = "module.ingest_pipeline"
    fontname = "sans-serif"
    "module.ingest_pipeline.data.archive_file.consumer_zip" [label="data.archive_file.consumer_zip"];
    "module.ingest_pipeline.data.aws_iam_policy_document.consumer" [label="data.aws_iam_policy_document.consumer"];
    "module.ingest_pipeline.data.aws_iam_policy_document.lambda_assume" [label="data.aws_iam_policy_document.lambda_assume"];
    "module.ingest_pipeline.aws_dynamodb_table.messages" [label="aws_dynamodb_table.messages"];
    "module.ingest_pipeline.aws_iam_role.consumer" [label="aws_iam_role.consumer"];
    "module.ingest_pipeline.aws_iam_role_policy.consumer" [label="aws_iam_role_policy.consumer"];
    "module.ingest_pipeline.aws_iam_role_policy_attachment.consumer_logs" [label="aws_iam_role_policy_attachment.consumer_logs"];
    "module.ingest_pipeline.aws_lambda_event_source_mapping.consumer" [label="aws_lambda_event_source_mapping.consumer"];
    "module.ingest_pipeline.aws_lambda_function.consumer" [label="aws_lambda_function.consumer"];
    "module.ingest_pipeline.aws_sqs_queue.dlq" [label="aws_sqs_queue.dlq"];
    "module.ingest_pipeline.aws_sqs_queue.main" [label="aws_sqs_queue.main"];
  }
  "module.ingest_pipeline.data.aws_iam_policy_document.consumer" -> "module.ingest_pipeline.aws_dynamodb_table.messages";
  "module.ingest_pipeline.data.aws_iam_policy_document.consumer" -> "module.ingest_pipeline.aws_sqs_queue.main";
  "module.ingest_pipeline.aws_iam_role.consumer" -> "module.ingest_pipeline.data.aws_iam_policy_document.lambda_assume";
  "module.ingest_pipeline.aws_iam_role_policy.consumer" -> "module.ingest_pipeline.data.aws_iam_policy_document.consumer";
  "module.ingest_pipeline.aws_iam_role_policy.consumer" -> "module.ingest_pipeline.aws_iam_role.consumer";
  "module.ingest_pipeline.aws_iam_role_policy_attachment.consumer_logs" -> "module.ingest_pipeline.aws_iam_role.consumer";
  "module.ingest_pipeline.aws_lambda_event_source_mapping.consumer" -> "module.ingest_pipeline.aws_iam_role_policy.consumer";
  "module.ingest_pipeline.aws_lambda_event_source_mapping.consumer" -> "module.ingest_pipeline.aws_lambda_function.consumer";
  "module.ingest_pipeline.aws_lambda_function.consumer" -> "module.ingest_pipeline.data.archive_file.consumer_zip";
  "module.ingest_pipeline.aws_lambda_function.consumer" -> "module.ingest_pipeline.aws_dynamodb_table.messages";
  "module.ingest_pipeline.aws_lambda_function.consumer" -> "module.ingest_pipeline.aws_iam_role.consumer";
  "module.ingest_pipeline.aws_sqs_queue.main" -> "module.ingest_pipeline.aws_sqs_queue.dlq";
}
